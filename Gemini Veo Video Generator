{"cells":[{"cell_type":"code","source":["import time\n","import os\n","import sys\n","from google import genai\n","from google.genai import types\n","from google.colab import userdata\n","\n","\"\"\"\n","Gemini Veo 3.1 Video Generation Script\n","--------------------------------------\n","This application interfaces with Google's GenAI SDK to generate cinematic videos\n","from text prompts using the Veo-3.1 model.\n","\n","Requirements:\n","1. pip install google-genai\n","2. A valid Google API Key set as an environment variable 'GOOGLE_API_KEY'\n","\"\"\"\n","\n","def generate_veo_video(prompt_text, output_file=\"generated_video.mp4\"):\n","    \"\"\"\n","    Handles the asynchronous generation and download of a video via the Veo model.\n","    \"\"\"\n","    try:\n","        # Initialize the client.\n","        # It looks for GOOGLE_API_KEY in environment variables by default.\n","        client = genai.Client()\n","\n","        print(f\"🚀 Initializing video generation...\")\n","        print(f\"📝 Prompt: '{prompt_text}'\")\n","\n","        # This sends the request to the Google servers to start rendering.\n","        operation = client.models.generate_videos(\n","            model=\"veo-3.1-generate-preview\",\n","            prompt=prompt_text,\n","        )\n","\n","        # Video generation is not instantaneous, so we must wait for the task to finish.\n","        start_time = time.time()\n","        polling_interval = 5 # Start with 5 seconds\n","        max_polling_interval = 60 # Cap at 60 seconds\n","\n","        while not operation.done:\n","            elapsed = int(time.time() - start_time)\n","            print(f\"⏳ Processing... ({elapsed}s elapsed) Polling again in {int(polling_interval)} seconds...\")\n","            time.sleep(polling_interval)\n","\n","            # Increase the polling interval progressively\n","            polling_interval = min(polling_interval * 1.5, max_polling_interval)\n","\n","            # Refresh the operation object to check current status\n","            operation = client.operations.get(operation)\n","\n","        # Check if the operation returned a valid response with video metadata\n","        if operation.response and operation.response.generated_videos:\n","            generated_video = operation.response.generated_videos[0]\n","\n","            print(f\"✅ Generation successful! Downloading file...\")\n","\n","            try:\n","                # Download the actual video bytes\n","                client.files.download(file=generated_video.video)\n","\n","                # Save the downloaded bytes to a local MP4 file\n","                generated_video.video.save(output_file)\n","\n","                full_path = os.path.abspath(output_file)\n","                print(f\"✨ Success! Your video is ready at: {full_path}\")\n","                return True\n","            except Exception as download_e:\n","                print(f\"❌ Error during video download or saving: {str(download_e)}\")\n","                return False\n","        else:\n","            # If the operation is 'done' but has no video, something went wrong\n","            error_detail = getattr(operation, 'error', 'No video found in response.')\n","            print(f\"❌ Generation finished but failed to produce a result: {error_detail}\")\n","            return False\n","\n","    except Exception as e:\n","        print(f\"❌ A runtime error occurred during video generation: {str(e)}\")\n","        return False\n","\n","if __name__ == \"__main__\":\n","    # Retrieve the API key from Colab secrets\n","    api_key = userdata.get('GOOGLE_API_KEY')\n","\n","    if not api_key:\n","        print(\"🛑 Error: GOOGLE_API_KEY not found in Colab secrets.\")\n","        print(\"Please set it using the '🔑' (Secrets) icon in the left panel.\")\n","        sys.exit(1)\n","\n","    # Set the environment variable so genai.Client() can pick it up\n","    os.environ['GOOGLE_API_KEY'] = api_key\n","\n","    # Define the cinematic prompt\n","    video_prompt = (\n","        \"A serene, futuristic cityscape at sunset. Skyscrapers with glowing windows reflect the last rays of sun. \"\n","        \"Flying vehicles glide silently between buildings. A lone figure stands on a high balcony, looking out over the city. \"\n","        \"The colors are warm, oranges and purples, with a soft, ethereal glow. Slow, sweeping camera movement.\"\n","    )\n","\n","    # Execute the generation\n","    generate_veo_video(video_prompt, \"dialogue_example.mp4\")"],"outputs":[],"execution_count":null,"metadata":{"id":"zZcMS4vipdFq"}}],"metadata":{"colab":{"provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}